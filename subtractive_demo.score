    <note measure="3" beat="1.5" duration="0.4" note="G4" wave="square" amp="0.22" attack="0.002" decay="0.15" sustain="0.1" release="0.05"/>
    <note measure="3" beat="2" duration="1.6" note="C4" wave="triangle" amp="0.3" attack="0.5" decay="0.1" sustain="0.7" release="0.4"/>
    <!-- Measure 4: polyphony. A chord, then a strum whose notes overlap. -->
