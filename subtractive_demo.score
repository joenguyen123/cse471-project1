<?xml version="1.0" encoding="utf-8"?>
<score bpm="120" beatspermeasure="4">
  <instrument instrument="Subtractive">
    <!-- Measure 1: table playback. Sawtooth, square, triangle, pulse at the same pitch. -->
    <note measure="1" beat="1" duration="0.9" note="C4" wave="sawtooth" amp="0.2" attack="0.01" decay="0.01" sustain="1" release="0.02"/>
    <note measure="1" beat="2" duration="0.9" note="C4" wave="square" amp="0.2" attack="0.01" decay="0.01" sustain="1" release="0.02"/>
    <note measure="1" beat="3" duration="0.9" note="C4" wave="triangle" amp="0.2" attack="0.01" decay="0.01" sustain="1" release="0.02"/>
    <note measure="1" beat="4" duration="0.9" note="C4" wave="pulse" amp="0.2" attack="0.01" decay="0.01" sustain="1" release="0.02"/>
    <!-- Measure 2: varying pitch. A sawtooth runs up to a high note with no aliasing. -->
